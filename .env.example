# Kopie als .env anlegen und ausfüllen. Die .env wird nie committet.

# ntfy: zufälliger, schwer erratbarer Name. Wer ihn kennt, kann mitlesen.
# Neu erzeugen: python3 -c "import secrets; print('zugbot-' + secrets.token_urlsafe(18))"
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Dashboard: lauscht nur lokal, Tailscale Funnel macht es per HTTPS öffentlich
# erreichbar (siehe README). Die Seite liegt unter /<DASHBOARD_SCHLUESSEL>/,
# alles andere ist 404. Wer den Schlüssel kennt, sieht deinen Fahrplan.
# Neu erzeugen: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
WEB_HOST=127.0.0.1
DASHBOARD_SCHLUESSEL=

# Transitous verlangt Name, Version und Kontakt im User-Agent.
USER_AGENT=zugbot/1.0 (+https://github.com/kashzCoding/zugbot)

# Optional: Gleise für Züge über die DB-Timetables-API
# (developers.deutschebahn.com -> Anwendung anlegen -> API "Timetables" abonnieren)
DB_CLIENT_ID=
DB_API_KEY=
